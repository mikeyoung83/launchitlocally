---
// Get the current URL path from Astro
const { pathname } = Astro.url;

// Mark a link active on its own page and any page beneath it ("/" only matches itself)
const isActive = (path: string) => {
    const current = pathname.replace(/\/$/, "") || "/";
    const match =
        path === "/"
            ? current === "/"
            : current === path || current.startsWith(path + "/");
    return match ? "text-primary font-bold" : "";
};
---

<li><a href="/" class={isActive("/")}>Home</a></li>
<li><a href="/services" class={isActive("/services")}>Services</a></li>
<li><a href="/pricing" class={isActive("/pricing")}>Pricing</a></li>
<li><a href="/contact" class={isActive("/contact")}>Contact</a></li>
<li class="mt-4 lg:mt-0 lg:ml-2">
    <a href="/contact" class="btn btn-primary btn-sm">Work With Us</a>
</li>
