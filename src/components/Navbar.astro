---
// src/components/Navbar.astro
import Logo from "./Logo.astro";
import LogoDark from "./LogoDark.astro";
import Nav from "../components/Nav.astro";
---

<div class="navbar bg-base-100 border-b border-base-300 px-4 sticky top-0 z-50">
    <div class="flex-1">
        <a
            href="/"
            class="flex items-center gap-2"
            aria-label="LaunchItLocally Home"
        >
            <Logo />
            <LogoDark />
        </a>
    </div>
    <div class="flex-none md:hidden">
        <button
            type="button"
            id="mobile-menu-button"
            class="btn btn-square btn-ghost"
            aria-controls="mobile-menu"
            aria-expanded="false"
        >
            <span class="sr-only" data-menu-label>Open menu</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="inline-block h-6 w-6 stroke-current"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
    <div class="flex-none flex items-center gap-4">
        <nav aria-label="Main" class="hidden md:block">
            <ul class="menu menu-horizontal px-1 font-medium">
                <Nav />
            </ul>
        </nav>

        <label
            for="theme-controller"
            class="swap swap-rotate btn btn-ghost btn-circle has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2"
        >
            <span class="sr-only">Toggle dark mode</span>
            <input
                id="theme-controller"
                name="theme-controller"
                type="checkbox"
                class="theme-controller"
                value="business"
            />

            <svg
                class="swap-off fill-current w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                    d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
                ></path></svg
            >

            <svg
                class="swap-on fill-current w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                    d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.69Z"
                ></path></svg
            >
        </label>
    </div>
</div>

<div class="drawer">
    <!-- daisyUI's drawer state. Driven by #mobile-menu-button, so it's kept
         out of the tab order and hidden from screen readers. -->
    <input
        id="mobile-drawer"
        type="checkbox"
        class="drawer-toggle"
        tabindex="-1"
        aria-hidden="true"
    />

    <div class="drawer-side">
        <button
            type="button"
            class="drawer-overlay"
            tabindex="-1"
            aria-hidden="true"
            data-menu-close></button>

        <nav
            id="mobile-menu"
            aria-label="Mobile"
            class="menu bg-base-200 min-h-full w-80 p-4 pt-30"
        >
            <ul class="text-2xl">
                <Nav />
            </ul>
        </nav>
    </div>

    <script>
        const drawer = document.getElementById(
            "mobile-drawer",
        ) as HTMLInputElement | null;
        const menuButton = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");
        const menuLabel = menuButton?.querySelector("[data-menu-label]");

        // daisyUI fades the drawer in after a short delay, and a link can't
        // take focus while it's still visibility: hidden, so retry each
        // frame (~0.5s max) until it sticks.
        function focusWhenVisible(el: HTMLElement, tries = 30) {
            if (!drawer?.checked) return;
            el.focus();
            if (document.activeElement !== el && tries > 0) {
                requestAnimationFrame(() => focusWhenVisible(el, tries - 1));
            }
        }

        function setMenuOpen(open: boolean, { restoreFocus = true } = {}) {
            if (!drawer || !menuButton) return;
            drawer.checked = open;
            menuButton.setAttribute("aria-expanded", String(open));
            if (menuLabel) menuLabel.textContent = open ? "Close menu" : "Open menu";
            const firstLink = menu?.querySelector("a");
            if (open && firstLink) {
                focusWhenVisible(firstLink);
            } else if (!open && restoreFocus) {
                menuButton.focus();
            }
        }

        menuButton?.addEventListener("click", () => setMenuOpen(!drawer?.checked));
        document
            .querySelector("[data-menu-close]")
            ?.addEventListener("click", () => setMenuOpen(false));
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && drawer?.checked) setMenuOpen(false);
        });
        // Close the drawer if the window grows past the mobile breakpoint
        // while it's open (the hamburger button is hidden from md up).
        matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
            if (e.matches && drawer?.checked) setMenuOpen(false, { restoreFocus: false });
        });

        const themeToggle = document.querySelector(
            ".theme-controller",
        ) as HTMLInputElement;
        // MainLayout's inline script has already applied the saved theme;
        // reflect it in the toggle.
        if (themeToggle) {
            themeToggle.checked =
                document.documentElement.getAttribute("data-theme") ===
                "business";
        }

        themeToggle?.addEventListener("change", (e) => {
            const target = e.target as HTMLInputElement;
            const newTheme = target.checked ? "business" : "corporate";
            document.documentElement.setAttribute("data-theme", newTheme);
            try {
                localStorage.setItem("theme", newTheme);
            } catch {}
        });
    </script>
</div>
