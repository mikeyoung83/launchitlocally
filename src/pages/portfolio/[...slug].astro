---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";

// 1. Generate paths for all entries
export async function getStaticPaths() {
    const portfolioEntries = await getCollection("portfolio");
    return portfolioEntries.map((entry: CollectionEntry<"portfolio">) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

// 2. Define exactly what the Props are
interface Props {
    entry: CollectionEntry<"portfolio">;
}

// 3. Get the specific entry from props
const { entry } = Astro.props;

// 4. Render Content
const { Content } = await render(entry);

// 5. Dates and the optional live-site link
const formattedDate = entry.data.publishDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
});
const projectUrl = entry.data.url || undefined;
const projectHost = projectUrl
    ? new URL(projectUrl).hostname.replace(/^www\./, "")
    : undefined;
---

<MainLayout
    title={`${entry.data.title} | Portfolio`}
    description={entry.data.description}
>
    <div class="bg-base-100 px-6 py-32 lg:px-8">
        <div class="mx-auto max-w-4xl text-base/7">
            <p class="text-base/7 font-bold text-primary uppercase">
                <time
                    datetime={entry.data.publishDate.toISOString().slice(0, 10)}
                    >{formattedDate}</time
                >
            </p>
            <h1
                class="mt-2 text-4xl font-semibold tracking-tight text-pretty sm:text-5xl"
            >
                {entry.data.title}
            </h1>

            <p class="mt-6 text-xl/8">
                {entry.data.intro}
            </p>
            {
                projectUrl && (
                    <a
                        href={projectUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary mt-8"
                    >
                        Visit {projectHost}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="size-4"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                            />
                        </svg>
                        <span class="sr-only">(opens in a new tab)</span>
                    </a>
                )
            }
            <div class="mt-10 max-w-4xl">
                <figure class="mt-16 mb-16">
                    <Image
                        src={entry.data.image}
                        alt={entry.data.title}
                        class="w-full object-cover rounded-3xl shadow-xl"
                    />
                </figure>

                <p>
                    {entry.data.description}
                </p>
                <div class="mt-10 space-y-6">
                    <Content />
                </div>
            </div>
            <div class="mt-20">
                <a href="/portfolio" class="btn btn-outline"
                    >← Back to Projects</a
                >
            </div>
        </div>
    </div>
</MainLayout>
