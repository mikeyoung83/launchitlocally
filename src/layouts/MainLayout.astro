---
import { getImage } from "astro:assets";
import { SEO } from "astro-seo";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import defaultOgSource from "../assets/home_header-hero.jpg";

interface Props {
    title: string;
    description: string;
    /** Absolute or root-relative URL to a 1200×630 image; defaults to the homepage hero */
    ogImage?: string;
    noindex?: boolean;
}

const { title, description, ogImage, noindex = false } = Astro.props;

const defaultOgImage = await getImage({
    src: defaultOgSource,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpg",
});
const ogImageUrl = new URL(ogImage ?? defaultOgImage.src, Astro.site).href;
---

<html lang="en" data-theme="corporate">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <SEO
            title={`${title} | LaunchItLocally`}
            description={description}
            noindex={noindex}
            openGraph={{
                basic: {
                    title,
                    type: "website",
                    image: ogImageUrl,
                },
                optional: {
                    description,
                    siteName: "LaunchItLocally",
                },
                image: { width: 1200, height: 630 },
            }}
            twitter={{ card: "summary_large_image" }}
        />
        <script is:inline>
            // Apply the saved (or OS-preferred) theme before first paint.
            (() => {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                if (theme !== "business" && theme !== "corporate") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches
                        ? "business"
                        : "corporate";
                }
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
    </head>
    <body class="min-h-screen flex flex-col">
        <a
            href="#main-content"
            class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60"
        >
            Skip to content
        </a>
        <Navbar />
        <main id="main-content" class="grow">
            <slot />
        </main>
        <Footer />
    </body>
</html>
